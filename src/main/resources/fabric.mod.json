{
  "schemaVersion": 1,
  "id": "bodycam",
  "version": "${version}",
  "name": "NEXUS Bodycam",
  "description": "Realistic bodycam-style camera with temporal effects, post-processing, DOF and tactical HUD for Minecraft 1.20.1",
  "authors": ["Adriano"],
  "contact": {
    "sources": "https://github.com/jhfuheuiwfh/nexus-bodycam-mod",
    "issues": "https://github.com/jhfuheuiwfh/nexus-bodycam-mod/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/bodycam/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.bodycam.BodycamClient"],
    "modmenu": ["dev.bodycam.BodycamModMenu"]
  },
  "mixins": ["bodycam.mixins.json"],
  "accessWidener": "bodycam.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.20.1",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.sources": "https://github.com/jhfuheuiwfh/nexus-bodycam-mod"
      },
      "badges": []
    }
  }
}